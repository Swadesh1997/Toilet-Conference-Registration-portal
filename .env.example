# Copy this file to .env and fill in your own values. Never commit .env.

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=toilet_conference

# Outgoing email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=registration@example.org
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=registration@example.org
MAIL_NOTIFY_ADDRESS=secretariat@example.org

# SSLCommerz payment gateway (sandbox by default)
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
